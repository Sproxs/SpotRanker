# Spotify App credentials — get yours at https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your_client_id_here
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Only needed locally. In the Cloudflare deployment this variable stays unset so
# the app derives the callback URL from the hostname it is served under.
# See CLOUDFLARE_DEPLOYMENT.md.
